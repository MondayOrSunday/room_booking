APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

WHITELIST_DOMAIN_PATTERNS=#^http?://localhost:\d+$#,#^http?://127\.0\.0\.1:\d+$#,#^http?://0\.0\.0\.0:\d+$#,#^https://[^.]+\.vercel\.app$#

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5433
DB_DATABASE=room_booking
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
